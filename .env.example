# Copy to `.env.local` (gitignored) and fill from the Supabase project settings.
# Project Settings → API: Project URL + anon / publishable key.
# Never put the service role key in the Expo app env.
#
# Expo reads EXPO_PUBLIC_* (not NEXT_PUBLIC_*). Prefer ANON_KEY; PUBLISHABLE_KEY
# is accepted as a fallback by the client (matches Expo's connect naming).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-sb_publishable-key

# Optional Open Food Facts API host override (default: https://world.openfoodfacts.org).
# User-Agent is a code constant (AppName/Version contact), not an env secret.
# EXPO_PUBLIC_OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
