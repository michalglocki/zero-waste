# Required — Cursor API key (https://cursor.com/dashboard → API Keys)
# Also set as a GitHub Actions secret named CURSOR_API_KEY for CI.
CURSOR_API_KEY=

# Optional — Cursor model id (default: composer-2.5)
# CURSOR_MODEL=

# Optional — git ref for PR/branch reviews (e.g. origin/main).
# When set (or when passing --base), CLI runs `git diff <base>...HEAD`
# instead of uncommitted `git diff HEAD`.
# REVIEW_BASE=

# Optional — comma-separated verdicts that should exit non-zero (e.g. request_changes)
# REVIEW_FAIL_ON=request_changes
