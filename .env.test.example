# Hosted Supabase credentials for jest-expo integration tests (seed + RLS).
# Copy to `.env.test.local` (gitignored via `.env*.local`).
#
# Use a dedicated *test* project — not production. Apply repo migrations with:
#   npx supabase login
#   npx supabase link --project-ref YOUR_PROJECT_REF
#   npx supabase db push
#
# Then fill from Project Settings → API:
#   Project URL → SUPABASE_URL
#   anon public → SUPABASE_ANON_KEY
#   service_role secret → SUPABASE_SERVICE_ROLE_KEY
#
# Service role is for test seed/teardown ONLY.
# Never put the service role in EXPO_PUBLIC_* or the Expo app `.env.local`.
# See __tests__/support/README.md.

SUPABASE_URL=https://YOUR_TEST_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-test-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-test-project-service-role-key
