# Local Supabase credentials for jest-expo integration tests (seed + RLS).
# Copy to `.env.test.local` (gitignored via `.env*.local`) after:
#   npx supabase start
#   npx supabase status -o env
#
# Map: API_URL → SUPABASE_URL, ANON_KEY → SUPABASE_ANON_KEY,
#      SERVICE_ROLE_KEY → SUPABASE_SERVICE_ROLE_KEY
#
# Service role is for test seed/teardown ONLY.
# Never put the service role in EXPO_PUBLIC_* or the Expo app `.env.local`.
# See __tests__/support/README.md.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
